-- PERFORMANCE MODE
local savedShadows = nil
local savedEffects = {}

local function enablePerformance()
    pcall(function()
        if savedShadows == nil then
            savedShadows = Lighting.GlobalShadows
        end

        Lighting.GlobalShadows = false
    end)

    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") then
            if savedEffects[effect] == nil then
                savedEffects[effect] = effect.Enabled
            end

            pcall(function()
                effect.Enabled = false
            end)
        end
    end
end

local function restorePerformance()
    if savedShadows ~= nil then
        pcall(function()
            Lighting.GlobalShadows = savedShadows
        end)
        savedShadows = nil
    end

    for effect, oldState in pairs(savedEffects) do
        pcall(function()
            if effect.Parent then
                effect.Enabled = oldState
            end
        end)
    end

    table.clear(savedEffects)
end

