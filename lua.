-- OBJECT MANAGEMENT
local created = {}
local originalSky = nil

local function track(object)
    table.insert(created, object)
    return object
end

local function clearObjects()
    for _, object in ipairs(created) do
        pcall(function()
            object:Destroy()
        end)
    end

    table.clear(created)
end

local function restoreSky()
    if not originalSky then return end

    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("Sky") then
            object:Destroy()
        end
    end

    for _, sky in ipairs(originalSky) do
        sky:Clone().Parent = Lighting
    end

    originalSky = nil
end

-- BLOCK CREATOR
local function createBlock(asset)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then return false end

    local part = Instance.new("Part")
    part.Name = "TIKI_ImageBlock"
    part.Size = Vector3.new(6, 6, 1)
    part.CFrame = root.CFrame * CFrame.new(0, 0, -10)
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Parent = workspace

    track(part)

    local faces = {
        Enum.NormalId.Front,
        Enum.NormalId.Back,
        Enum.NormalId.Left,
        Enum.NormalId.Right,
        Enum.NormalId.Top,
        Enum.NormalId.Bottom
    }

    for _, face in ipairs(faces) do
        local gui = Instance.new("SurfaceGui")
        gui.Face = face
        gui.LightInfluence = 0
        gui.Parent = part

        local img = Instance.new("ImageLabel")
        img.Size = UDim2.fromScale(1, 1)
        img.BackgroundTransparency = 1
        img.Image = asset
        img.Parent = gui
    end

    return true
end

-- SKYBOX
local function applySky(asset)
    if not originalSky then
        originalSky = {}

        for _, object in ipairs(Lighting:GetChildren()) do
            if object:IsA("Sky") then
                table.insert(originalSky, object:Clone())
            end
        end
    end

    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("Sky") then
            object:Destroy()
        end
    end

    local sky = Instance.new("Sky")

    sky.SkyboxBk = asset
    sky.SkyboxDn = asset
    sky.SkyboxFt = asset
    sky.SkyboxLf = asset
    sky.SkyboxRt = asset
    sky.SkyboxUp = asset

    sky.Parent = Lighting
end

-- AVATAR IMAGE
local function applyAvatar(asset)
    local char = player.Character
    local head = char and char:FindFirstChild("Head")

    if not head then return false end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TIKI_AvatarImage"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(90, 90)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char

    track(billboard)

    local img = Instance.new("ImageLabel")
    img.Size = UDim2.fromScale(1, 1)
    img.BackgroundTransparency = 1
    img.Image = asset
    img.Parent = billboard

    return true
end

-- PARTICLE EFFECTS
local function applyEffects(asset)
    local char = player.Character
    local head = char and char:FindFirstChild("Head")

    if not head then return false end

    local attachment = Instance.new("Attachment")
    attachment.Name = "TIKI_Attachment"
    attachment.Parent = head

    track(attachment)

    local particles = Instance.new("ParticleEmitter")

    particles.Texture = asset
    particles.Rate = performanceMode and 3 or 8
    particles.Lifetime = NumberRange.new(0.8, 1.2)
    particles.Speed = NumberRange.new(1, 2)
    particles.SpreadAngle = Vector2.new(180, 180)
    particles.Size = NumberSequence.new(0.35)
    particles.LightEmission = 0
    particles.Enabled = true
    particles.Parent = attachment

    return true
end

